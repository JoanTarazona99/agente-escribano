# ─── Django ──────────────────────────────────────────────
DJANGO_SECRET_KEY=change-me-in-production-use-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ─── Base de datos ────────────────────────────────────────
# Para producción: DATABASE_URL=postgresql://user:pass@host:5432/dbname
DATABASE_URL=sqlite:///db.sqlite3

# ─── LLM Provider ─────────────────────────────────────────
# 'ollama' para desarrollo local (requiere docker-compose) 
# 'openrouter' para producción Render (requiere OPENROUTER_API_KEY)
LLM_PROVIDER=ollama

# ─── Ollama (desarrollo local) ────────────────────────────
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2

# ─── OpenRouter (producción Render) ───────────────────────
# API key de OpenRouter: https://openrouter.ai/workspaces/default/keys
# Solo es necesario si LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
# Modelo: openrouter/auto | meta-llama/llama-3.1-8b-instruct:free | ...
# Default (gratuito): meta-llama/llama-3.1-8b-instruct:free
# OPENROUTER_MODEL=openrouter/auto

# ─── API Keys académicas (opcionales hasta obtenerlas) ───
SCOPUS_API_KEY=
WOS_API_KEY=

# ─── CORS ────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ─── Frontend ────────────────────────────────────────────
VITE_API_URL=http://localhost:8000
